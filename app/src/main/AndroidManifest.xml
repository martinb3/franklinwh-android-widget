<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_battery"
        android:label="@string/app_name"
        android:theme="@style/Theme.Fwh">

        <!-- The launcher entry lets a sideloaded install be opened once, leaving the stopped state.
             Launchers can only start exported activities, so this must be exported while it has one. -->
        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Three widgets share data, refresh and rendering. FwhWidgetReceiver / fwh_widget_info
             keep their original names so already-placed "Energy summary" widgets survive updates. -->
        <receiver
            android:name=".ui.StripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fwh_strip_info" />
        </receiver>

        <receiver
            android:name=".ui.FwhWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_summary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fwh_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.DashboardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_dashboard_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fwh_dashboard_info" />
        </receiver>
    </application>

</manifest>
